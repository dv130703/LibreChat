#=====================================================================#
#                       LibreChat Configuration                       #
#=====================================================================#
# This is the trimmed set of variables this fork actually reads.      #
# For everything else (OAuth/SSO, cloud storage, image-gen tools,     #
# web search, observability, MCP tuning, ...) see:                    #
# https://www.librechat.ai/docs/configuration/dotenv                  #
#=====================================================================#

#==================================================#
#               Server Configuration               #
#==================================================#

HOST=localhost
PORT=3080

MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

NO_INDEX=true
# Use the address that is at most n number of hops away from the Express application.
# A value of 0 means no reverse proxy (req.socket.remoteAddress is trusted directly).
TRUST_PROXY=1

#==================================================#
#                   Admin Panel                    #
#==================================================#

# External admin panel base URL, used for admin OAuth/SSO redirects.
# Required only when the admin panel is hosted separately from LibreChat.
ADMIN_PANEL_URL=

# Session encryption key for the bundled admin panel (min 32 characters).
# Generate with: openssl rand -hex 32
ADMIN_PANEL_SESSION_SECRET=

#==================================================#
#                     Logging                      #
#==================================================#

CONSOLE_JSON=false
DEBUG_LOGGING=true
DEBUG_CONSOLE=true
LOG_TO_FILE=true
AGENT_DEBUG_LOGGING=true

#==================================================#
#                  Node Options                    #
#==================================================#

# NODE_MAX_OLD_SPACE_SIZE is a CI/CD build arg only - it does NOT set the
# runtime heap size. For that, use NODE_OPTIONS="--max-old-space-size=6144".
NODE_MAX_OLD_SPACE_SIZE=6144

#==================================================#
#                 Model Providers                  #
#==================================================#

# Base URL of your local Ollama server. This alone does not make Ollama
# appear in model selection - it only supplies the URL for the 'Ollama'
# entry under endpoints.custom in librechat.yaml (see librechat.example.yaml).
OLLAMA_BASE_URL="http://192.168.1.123:11434"

#==================================================#
#              Security & Credentials              #
#==================================================#
# All four are required. The values below are the published .env.example
# defaults - regenerate before running anything beyond a one-off local test:
#   openssl rand -hex 32   -> CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET
#   openssl rand -hex 16   -> CREDS_IV

CREDS_KEY="d216e38024013316c385083742588d1a7e2c32d962e3ca5cf133f3ed7f38725d"
CREDS_IV="fad8c3cbce923dbc0d8103c1e28b7c88"

JWT_SECRET="2f841a15848a7599801beb96a9aaba02c77f28f0b33895d62065f77a04216925"
JWT_REFRESH_SECRET="caf84151fc1e8ae0c4dea0470ebf7ca4404390a94892adc3a38602b087220705"

#==================================================#
#            Search (Meilisearch, optional)        #
#==================================================#

SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt

#==================================================#
#              RAG / File Search (optional)        #
#==================================================#
# Points at this repo's local rag_server (see SETUP.md step 7), not
# upstream's rag_api container. Must match RAG_PORT in rag_server/.env.

RAG_API_URL=http://localhost:1234

#===================================================#
#                    User System                    #
#===================================================#

# --- Moderation ---
OPENAI_MODERATION=false
OPENAI_MODERATION_API_KEY=

# --- Bans & rate limiting ---
BAN_VIOLATIONS=true
BAN_DURATION=1000 * 60 * 60 * 2
BAN_INTERVAL=20

LOGIN_VIOLATION_SCORE=1
REGISTRATION_VIOLATION_SCORE=1
CONCURRENT_VIOLATION_SCORE=1
MESSAGE_VIOLATION_SCORE=1
NON_BROWSER_VIOLATION_SCORE=20
TTS_VIOLATION_SCORE=0
STT_VIOLATION_SCORE=0
FORK_VIOLATION_SCORE=0
IMPORT_VIOLATION_SCORE=0
FILE_UPLOAD_VIOLATION_SCORE=0
ILLEGAL_MODEL_REQ_SCORE=5

LOGIN_MAX=7
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60

LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2

LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=40
MESSAGE_IP_WINDOW=1

LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1

# --- Registration & login ---
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

#==================================================#
#                   Shared Links                   #
#==================================================#

ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

#===================================================#
#                        UI                         #
#===================================================#

APP_TITLE=LibreChat
HELP_AND_FAQ_URL=https://librechat.ai
